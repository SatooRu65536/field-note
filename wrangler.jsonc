{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "field-note",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    {
      "pattern": "field-note.satooru.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "field-note",
      "database_id": "9498a3ba-2f45-4dc6-8a3f-61dfda798de8",
      "migrations_dir": "drizzle",
      "remote": true,
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "field-note-photos",
      "remote": true,
    }
  ]
}
