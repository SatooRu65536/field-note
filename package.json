{
  "name": "field-note",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@pandacss/dev": "^1.12.0",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
